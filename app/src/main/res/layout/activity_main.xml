<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cf_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/cf_blue_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dashboard_subtitle"
            android:textColor="@color/cf_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/dashboard_summary_title"
            android:textColor="@color/cf_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Contagens iniciais; serão calculadas com os dados do Room. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtPendentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_pending_initial"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtConcluidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dashboard_completed_initial"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtAtrasadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dashboard_overdue_initial"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="@string/disciplines_open"
            android:textAllCaps="false"
            android:textColor="@color/cf_white"
            android:textSize="16sp"
            app:backgroundTint="@color/cf_blue"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/dashboard_activities_title"
            android:textColor="@color/cf_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_empty_title"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dashboard_empty_description"
                android:textColor="@color/cf_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
