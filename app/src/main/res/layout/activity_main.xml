<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cf_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/cf_blue_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnAparencia"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/aparencia_ativar_escura"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_tema_lua" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dashboard_subtitle"
            android:textColor="@color/cf_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/dashboard_summary_title"
            android:textColor="@color/cf_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Os valores reais são preenchidos a partir do Room. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtPendentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtConcluidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtAtrasadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtEstadoResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/activities_loading"
                android:textColor="@color/cf_text_primary"
                android:textSize="18sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecarregarResumo" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/retry_button" android:textAllCaps="false"
                android:visibility="gone" android:textColor="@color/cf_white" app:backgroundTint="@color/cf_blue" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="@string/disciplines_open"
            android:textAllCaps="false"
            android:textColor="@color/cf_white"
            android:textSize="16sp"
            app:backgroundTint="@color/cf_blue"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtividades"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="@string/activities_open"
            android:textAllCaps="false"
            android:textColor="@color/cf_blue_dark"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/cf_border" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnMoodle"
            style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp"
            android:text="@string/moodle_title" android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
