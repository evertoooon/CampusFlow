<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/txtEventoCalendario" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/cf_text_primary" />
    <TextView android:id="@+id/txtPrazoCalendario" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textColor="@color/cf_text_secondary" />
    <Spinner android:id="@+id/spinnerDisciplinaCalendario" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:spinnerMode="dropdown" android:saveEnabled="false" />
</LinearLayout>
