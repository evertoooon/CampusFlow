<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cor de fundo principal -->
    <item>
        <color android:color="@color/cf_background" />
    </item>

    <!-- Detalhe decorativo circular no canto superior esquerdo -->
    <item
        android:width="260dp"
        android:height="260dp"
        android:top="-110dp"
        android:left="-90dp">
        <shape android:shape="oval">
            <solid android:color="@color/cf_login_decoration_start" />
        </shape>
    </item>

    <!-- Detalhe decorativo suave no canto superior direito -->
    <item
        android:width="200dp"
        android:height="200dp"
        android:top="-70dp"
        android:right="-70dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <solid android:color="@color/cf_login_decoration_end" />
        </shape>
    </item>

    <!-- Detalhe decorativo circular no canto inferior direito -->
    <item
        android:width="280dp"
        android:height="280dp"
        android:bottom="-130dp"
        android:right="-90dp"
        android:gravity="bottom|end">
        <shape android:shape="oval">
            <solid android:color="@color/cf_login_decoration_bottom" />
        </shape>
    </item>
</layer-list>
